    "Start automatically when you log in to your Mac": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Macにログインしたら自動で起動する"
          }
        }
      }
    },
    "Sync to iPhone": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "iPhoneに同期"
          }
        }
      }
    },
    "Send usage to iPhone via iCloud": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "使用量をiCloud経由でiPhoneに送る"
          }
        }
      }
    },
    "Could not change launch at login": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ログイン時の起動設定を変更できませんでした"
          }
        }
      }
    },
    "Check Login Items in System Settings.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "システム設定のログイン項目を確認してください。"
          }
        }
      }
    },
    "OK": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "OK"
          }
        }
      }
    },
    "This Mac isn't signed in to iCloud, so syncing is paused. The menu bar keeps updating.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このMacはiCloudにサインインしていないため、同期は止まっています。メニューバーの表示は続けます。"
          }
        }
      }
    },
