      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "使用中の更新間隔"
          }
        }
      }
    },
    "While Claude Code or Codex is at work. Otherwise every 30 minutes, since usage elsewhere still counts.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Claude Code か Codex が動いている間の間隔です。それ以外のときも、ほかの場所での利用が数に入るため30分ごとに取得します。"
          }
        }
      }
    },
    "5 minutes": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "5分"
          }
        }
      }
    },
    "15 minutes": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "15分"
          }
        }
      }
